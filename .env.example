NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
# Server-only HMAC secret, at least 32 characters. Never expose it with NEXT_PUBLIC_.
COMPANY_SATISFACTION_TOKEN_SECRET=replace-with-a-long-server-only-secret
# Server-only stable Auth profile id allowed to use Karine's signature in eligible PDFs.
KONFORMUP_KARINE_TRAINER_PROFILE_ID=
NEXT_PUBLIC_SITE_URL=https://www.konformup.com
APP_URL=https://app.konformup.com
NEXT_PUBLIC_APP_URL=https://app.konformup.com
BREVO_API_KEY=brevo-api-key-placeholder
BREVO_SENDER_EMAIL=contact@konformup.com
BREVO_SENDER_NAME=Konform’up
ORGANIZATION_EMAIL=contact@konformup.com
ORGANIZATION_PHONE=0102030405
CRON_SECRET=change-me-if-you-call-the-cron-route-manually
# Server-only kill switch: only the literal value true may send MAC SST reminders.
MAC_SST_REMINDERS_ENABLED=false
